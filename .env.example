# ============================================================
# GOZZ CRM — Raíz del monorepo   (.env)
# ------------------------------------------------------------
# Lo leen los scripts de Node que corren desde la raíz vía
# `dotenv/config`:  pnpm migrate, pnpm seed:super-admin, y los
# scripts de mantenimiento en /scripts (backfills, etc.).
#
# Usa el mismo set de variables que apps/api/.env. Para usarlo:
#   1. Copia:  cp .env.example .env
#   2. Rellena los valores CHANGE_ME (basta con que coincidan
#      con apps/api/.env, sobre todo DATABASE_URL y DB_SCHEMA).
# El .env real NO se versiona (secretos). Ver .gitignore.
# ============================================================

# --- Entorno / red ---
NODE_ENV=development
TZ=America/New_York
APP_URL=http://localhost:3100
API_URL=http://localhost:4100
FRONTEND_PORT=3100
API_PORT=4100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Base de datos (PostgreSQL) — lo más usado por los scripts ---
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/crm_staging
DB_SCHEMA=gozz

# --- Auth / criptografía ---
JWT_SECRET=CHANGE_ME_hex_largo_aleatorio
JWT_EXPIRES_IN=365d
REFRESH_TOKEN_EXPIRES_IN=7d
PII_ENCRYPTION_KEY=CHANGE_ME_clave_para_cifrar_PII
APP_ENC_KEY=CHANGE_ME_hex_de_32_bytes

# --- Super admin inicial (pnpm seed:super-admin) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=CHANGE_ME

# --- Redis (opcional) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Cookies / video ---
COOKIE_SECURE=false
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# --- IA (opcional) ---
AI_URL=http://127.0.0.1:8100
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- LiveKit (opcional) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://tu-dominio/livekit
LIVEKIT_HOST_URL=ws://localhost:7880

# --- Bridges / SSO (opcional) ---
INTERNAL_BRIDGE_SECRET=
SSO_BRIDGE_SECRET=

# --- URLs públicas apps externas ---
CIUDADANIA_BASE_URL=https://curso.tuimpulsolatino.com
ACADEMIA_BASE_URL=https://academiadeingles.tuimpulsolatino.com

# --- Integraciones CRM externas (opcional) ---
BITRIX24_WEBHOOK=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# --- Google OAuth2 (opcional) ---
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4100/api/buzones/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Web Push (VAPID) (opcional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com
