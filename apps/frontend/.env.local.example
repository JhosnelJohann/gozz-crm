# Variables locales del frontend (Next.js las lee desde ESTA carpeta, no desde la raíz).
# gitignoreado — no se sube. En prod esta variable NO se define (socket usa mismo origen / nginx).

# Tiempo real en local: el front (:3100) y la API (:4100) están en puertos distintos y el dev
# server de Next no proxea WebSockets. Con esto el socket conecta directo a la API local.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100
