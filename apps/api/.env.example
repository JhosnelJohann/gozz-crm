# ============================================================
# GOZZ CRM — Backend / API   (apps/api/.env)
# ------------------------------------------------------------
# Plantilla de variables de entorno. Para usarla:
#   1. Copia este archivo:  cp apps/api/.env.example apps/api/.env
#   2. Rellena los valores marcados como CHANGE_ME.
# El .env real NO se versiona (contiene secretos). Ver .gitignore.
#
# Las variables marcadas (opcional) no son necesarias para
# arrancar el CRM en local; solo habilitan integraciones extra.
# ============================================================

# --- Entorno / red ---
NODE_ENV=development
TZ=America/New_York
APP_URL=http://localhost:3100
API_URL=http://localhost:4100
FRONTEND_PORT=3100
API_PORT=4100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Base de datos (PostgreSQL) ---
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/crm_staging
DB_SCHEMA=gozz

# --- Auth / criptografía (genera valores propios; NO reutilices los de producción) ---
# Generar un secreto fuerte:  openssl rand -hex 48
JWT_SECRET=CHANGE_ME_hex_largo_aleatorio
JWT_EXPIRES_IN=365d
REFRESH_TOKEN_EXPIRES_IN=7d
# Clave maestra para cifrar PII en la base de datos
PII_ENCRYPTION_KEY=CHANGE_ME_clave_para_cifrar_PII
# Clave para cifrar credenciales de integraciones. Generar: openssl rand -hex 32
APP_ENC_KEY=CHANGE_ME_hex_de_32_bytes

# --- Super admin inicial (se crea con: pnpm seed:super-admin) ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PASSWORD=CHANGE_ME

# --- Redis (colas/cache). Opcional para arrancar; déjalo si tienes Redis local ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Cookies / video ---
COOKIE_SECURE=false            # false en http local; true SOLO en producción https
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# --- Servicio de IA (apps/ai, FastAPI) (opcional) ---
AI_URL=http://127.0.0.1:8100
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- LiveKit (videollamadas) (opcional) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://tu-dominio/livekit
LIVEKIT_HOST_URL=ws://localhost:7880

# --- Bridges internos / SSO (opcional) ---
INTERNAL_BRIDGE_SECRET=
SSO_BRIDGE_SECRET=

# --- URLs públicas de apps externas (SSO) ---
CIUDADANIA_BASE_URL=https://curso.tuimpulsolatino.com
ACADEMIA_BASE_URL=https://academiadeingles.tuimpulsolatino.com

# --- Integraciones CRM externas (opcional) ---
BITRIX24_WEBHOOK=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# --- Google OAuth2 (conectar buzones Gmail) (opcional) ---
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4100/api/buzones/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Web Push (VAPID) (opcional) ---
# Generar par de claves:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com

# --- Almacenamiento de archivos subidos ---
# Carpeta donde se guardan los archivos subidos (notas, pagos, chat, avatares...).
# En LOCAL apúntala a una carpeta de tu máquina (ver README; es git-ignored, solo pruebas).
# Si se deja vacía, usa por defecto /root/gozz-crm/data/uploads (ruta del VPS).
UPLOADS_DIR=

# --- Cloudflare R2 (object storage: servir/subir archivos del Drive) (opcional) ---
# Si las 4 credenciales + bucket están presentes, el CRM lee/escribe los bytes desde R2
# (con disco local como fallback). Si falta alguna,
# R2 queda deshabilitado (r2Enabled=false) y se usa disco local como hasta ahora.
# El bucket es POR ENTORNO (R2_BUCKET): el mismo código apunta al bucket correcto según cada .env.
# NO commitees secretos reales: el .env real se puebla por fuera (VPS). Estos son placeholders.
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET=gozz-crm-staging
R2_REGION=auto
